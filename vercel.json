{
    "version": 2,
    "name": "Vital Visits",
    "builds": [
      {
        "src": "backend/index.js",
        "use": "@vercel/node" 
      },
      {
        "src": "frontend/src/index.js",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "backend/server.js"
      },
      {
        "src": "/(.*)",
        "dest": "frontend/build/$1"
      }
    ]
  }
  